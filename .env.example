# Environment (development | production)
ENV=development

# Server host & port
HOST=0.0.0.0
PORT=5000
DEBUG=false

# Security & API Secrets
SECRET_KEY=change-this-in-production-to-a-secure-random-string
API_KEY=hello-from-pi-lets-make-it-work

# CORS Allowed Origins (comma-separated)
CORS_ALLOW_ORIGINS=http://localhost:5000,http://localhost:5173,http://127.0.0.1:5000,http://127.0.0.1:5173

# Optional LLM integration (OpenAI)
USE_REAL_LLM=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

